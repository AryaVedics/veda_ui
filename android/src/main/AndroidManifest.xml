<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Véda Link, live sharing between the Véda apps on one phone (see
         veda_ui/BRIDGE.md). Every app publishes ONE feed through a content
         provider. The provider checks WHO is asking (FamilyKeys.kt): the
         caller must be a Véda app signed with one of our pinned certificates,
         so each app can keep its own signing key. -->

    <!-- Android 11+ hides other apps unless they are declared: we need to see
         the family's packages (to check who is asking) and their providers
         (to read their feeds). -->
    <queries>
        <package android:name="com.aryavedics.skin" />
        <package android:name="com.aryavedics.sun" />
        <package android:name="com.aryavedics.lifestyle" />
        <package android:name="com.aryavedics.cycle" />
        <package android:name="com.aryavedics.routine" />
        <provider android:authorities="com.aryavedics.sun.link" />
        <provider android:authorities="com.aryavedics.lifestyle.link" />
        <provider android:authorities="com.aryavedics.cycle.link" />
        <provider android:authorities="com.aryavedics.routine.link" />
        <provider android:authorities="com.aryavedics.skin.link" />
    </queries>

    <application>
        <provider
            android:name="com.aryavedics.veda_ui.VedaLinkProvider"
            android:authorities="${applicationId}.link"
            android:exported="true" />
    </application>
</manifest>
